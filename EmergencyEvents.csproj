<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <OutputType>Library</OutputType>
    <AssemblyName>EmergencyEvents</AssemblyName>
    <RootNamespace>EmergencyEvents</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Evaluation.Tests\**" />
    <EmbeddedResource Remove="Evaluation.Tests\**" />
    <None Remove="Evaluation.Tests\**" />
    <Content Remove="Evaluation.Tests\**" />
    <Compile Remove="RuntimeHarness\**" />
    <EmbeddedResource Remove="RuntimeHarness\**" />
    <None Remove="RuntimeHarness\**" />
    <Content Remove="RuntimeHarness\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExMod.Exiled" Version="9.14.2" />
    <Reference Include="UnityEngine.CoreModule" Condition="'$(SL_REFERENCES)' != ''">
      <HintPath>$(SL_REFERENCES)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule" Condition="'$(SL_REFERENCES)' != ''">
      <HintPath>$(SL_REFERENCES)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror" Condition="'$(SL_REFERENCES)' != ''">
      <HintPath>$(SL_REFERENCES)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Condition="'$(SL_REFERENCES)' != ''">
      <HintPath>$(SL_REFERENCES)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
