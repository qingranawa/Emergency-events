<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RoundCore\PopulationTier.cs" Link="RoundCore\PopulationTier.cs" />
    <Compile Include="..\RoundCore\BadgeRegistry.cs" Link="RoundCore\BadgeRegistry.cs" />
    <Compile Include="..\RoundCore\RoundRestartResetter.cs" Link="RoundCore\RoundRestartResetter.cs" />
    <Compile Include="..\Runtime\*.cs" Link="Runtime\%(Filename)%(Extension)" />
    <Compile Include="..\Reinforcement\PrimaryWavePolicy.cs" Link="Reinforcement\PrimaryWavePolicy.cs" />
    <Compile Include="..\Reinforcement\PrimaryWaveTimerExtensionPolicy.cs" Link="Reinforcement\PrimaryWaveTimerExtensionPolicy.cs" />
    <Compile Include="..\Reinforcement\MajorWaveHistory.cs" Link="Reinforcement\MajorWaveHistory.cs" />
    <Compile Include="..\RoundCore\ScpRolePolicy.cs" Link="RoundCore\ScpRolePolicy.cs" />
    <Compile Include="..\Crisis\**\*.cs" Link="Crisis\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\RemoteAdminCommands\*.cs" Exclude="..\RemoteAdminCommands\EmergencyEventsCommand.cs" Link="RemoteAdminCommands\%(Filename)%(Extension)" />
    <Compile Include="..\Evaluation\*.cs" Exclude="..\Evaluation\SnapshotCollector.cs;..\Evaluation\DlrcEvaluatorService.cs" Link="Evaluation\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
